# SMS VERIFICATION CODES - AFRICAS TALKING API KEY
AFRICAS_TALKING_USERNAME="sandbox"
AFRICAS_TAlKING_API_KEY=api_key

# MPESA STK PUSH
CONSUMER_KEY =consumer_key
CONSUMER_SECRET =consumer_secret
TARGET_PHONE =your_number
OAUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate
STK_URL =https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest

# Target Test Profiles
# Note: AT expects the '+' sign, while Safaricom expects digits only
PLAYER_PHONE_SMS = "your_number"
PLAYER_PHONE_MPESA = "your_number"

# NGROK TUNNEL 
NGROK_URL = your_tunnel_url

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BETS_SUBMITTED_TOPIC=bets-submitted
BETS_RESULTS_TOPIC=bets-results
ODDS_UPDATES_TOPIC=odds-updates

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting
PGPASSWORD=postgres

# Service Ports & URLs
INGRESS_PORT=8000
INGRESS_URL=http://localhost:8000
ODDS_PORT=8001
ODDS_WS_URL=ws://localhost:8001/ws/odds
SETTLEMENT_PORT=8002
SETTLEMENT_URL=http://localhost:8002

# Authentication & Security
JWT_SECRET_KEY=distributed-betting-platform-secure-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Simulation & Risk Parameters
ODDS_TICK_RATE_HZ=20
MAX_STALE_QUOTE_MS=200
SINGLE_ACCOUNT_EXPOSURE_CAP_CENTS=1000000
