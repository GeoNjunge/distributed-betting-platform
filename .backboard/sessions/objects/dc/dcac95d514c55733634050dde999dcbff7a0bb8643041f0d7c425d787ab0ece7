import { Component, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { NgIf } from '@angular/common';

import { AuthService } from '../../core/services/auth.service';

@Component({
  selector: 'app-auth-panel',
  standalone: true,
  imports: [FormsModule, NgIf],
  template: `
    <section class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-glow backdrop-blur">
      <div class="mb-4 flex items-center justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-emerald-300">Session</p>
          <h2 class="text-xl font-semibold text-white">Account Access</h2>
        </div>
        <span class="rounded-full px-3 py-1 text-xs font-semibold" [class.bg-emerald-500]="auth.isAuthenticated()" [class.text-felt-900]="auth.isAuthenticated()" [class.bg-slate-700]="!auth.isAuthenticated()" [class.text-slate-200]="!auth.isAuthenticated()">
          {{ auth.isAuthenticated() ? 'AUTHENTICATED' : 'SIGNED OUT' }}
        </span>
      </div>

      <form class="grid gap-3" (ngSubmit)="login()">
        <label class="grid gap-1 text-sm text-slate-300">
          Email
          <input class="rounded-xl border border-white/10 bg-felt-900 px-3 py-2 text-white outline-none ring-emerald-400 focus:ring-2" name="email" type="email" [(ngModel)]="email" required>
        </label>
        <label class="grid gap-1 text-sm text-slate-300">
          Password
          <input class="rounded-xl border border-white/10 bg-felt-900 px-3 py-2 text-white outline-none ring-emerald-400 focus:ring-2" name="password" type="password" [(ngModel)]="password" required minlength="12">
        </label>
        <div class="grid grid-cols-2 gap-3">
          <button class="rounded-xl bg-emerald-400 px-4 py-2 font-semibold text-felt-900 hover:bg-emerald-300" type="button" (click)="register()">Register</button>
          <button class="rounded-xl bg-sky-400 px-4 py-2 font-semibold text-slate-950 hover:bg-sky-300" type="submit">Login</button>
        </div>
      </form>

      <p *ngIf="message()" class="mt-3 text-sm text-slate-300">{{ message() }}</p>
    </section>
  `
})
export class AuthPanelComponent {
  email = 'e2e-user@example.com';
  password = 'correct-horse-battery-staple';
  readonly message = signal('');

  constructor(readonly auth: AuthService) {}

  register(): void {
    this.auth.register(this.email, this.password).subscribe({
      next: (session) => this.message.set(`Registered ${session.email}`),
      error: (error) => this.message.set(error?.error?.detail ?? 'Registration failed')
    });
  }

  login(): void {
    this.auth.login(this.email, this.password).subscribe({
      next: (session) => this.message.set(`Logged in as ${session.email}`),
      error: (error) => this.message.set(error?.error?.detail ?? 'Login failed')
    });
  }
}
