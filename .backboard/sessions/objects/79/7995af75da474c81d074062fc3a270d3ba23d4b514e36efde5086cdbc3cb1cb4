#!/usr/bin/env bash

# ==============================================================================
# Local Process Orchestrator (Docker-Free Replacement for `docker compose up`)
# ==============================================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="${ROOT_DIR}/logs"
mkdir -p "${LOG_DIR}"

export KAFKA_BOOTSTRAP_SERVERS="${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}"
export BETS_SUBMITTED_TOPIC="${BETS_SUBMITTED_TOPIC:-bets-submitted}"
export BETS_RESULTS_TOPIC="${BETS_RESULTS_TOPIC:-bets-results}"
export ODDS_UPDATES_TOPIC="${ODDS_UPDATES_TOPIC:-odds-updates}"
export COOKIE_SECURE="${COOKIE_SECURE:-false}"
export JWT_SECRET_KEY="${JWT_SECRET_KEY:-local-dev-secret-change-me}"
export DATABASE_URL="${DATABASE_URL:-postgresql+asyncpg://postgres:postgres@localhost:5432/betting}"
export RISK_BALANCE_SEEDS="${RISK_BALANCE_SEEDS:-dd3e8d4a-951f-5c9c-b6ea-25ee499f1acd:10000,demo-account:100000}"

# Track background PIDs for cleanup
PIDS=()

cleanup() {
    echo -e "\n\039[33m[!] Shutting down all local microservices...\033[0m"
    for pid in "${PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
        fi
    done
    wait 2>/dev/null
    echo -e "\033[32m[✓] All services stopped cleanly.\033[0m"
    exit 0
}

trap cleanup SIGINT SIGTERM EXIT

# Helper to run a service
run_service() {
    local name="$1"
    local dir="$2"
    local cmd="$3"

    echo -e "\033[34m[*] Starting ${name}...\033[0m"
    (
        cd "${dir}" || exit 1
        if [ -d ".venv" ]; then
            source .venv/bin/activate
        fi
        exec ${cmd}
    ) > "${LOG_DIR}/${name}.log" 2>&1 &

    PIDS+=($!)
    echo -e "\033[32m[✓] ${name} running (PID: ${PIDS[-1]}, Log: logs/${name}.log)\033[0m"
}

ensure_risk_engine_binary() {
    local binary="${ROOT_DIR}/risk_engine/build/risk_engine"
    if [ -x "${binary}" ]; then
        return 0
    fi

    echo -e "\033[33m[!] risk_engine binary missing; building it now...\033[0m"
    (
        cd "${ROOT_DIR}/risk_engine" || exit 1
        cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DRISK_ENGINE_ENABLE_ASAN=OFF
        cmake --build build --target risk_engine
    ) > "${LOG_DIR}/risk_engine_build.log" 2>&1 || {
        echo -e "\033[31m[X] Failed to build risk_engine. See logs/risk_engine_build.log\033[0m"
        exit 1
    }
}

ensure_postgres_database() {
    if ! command -v psql >/dev/null 2>&1; then
        return 0
    fi

    if command -v sudo >/dev/null 2>&1; then
        sudo -u postgres psql -v ON_ERROR_STOP=1 -tc "SELECT 1" >/dev/null 2>&1 || return 0
        sudo -u postgres psql -v ON_ERROR_STOP=1 -c "ALTER USER postgres WITH PASSWORD 'postgres';" >/dev/null 2>&1 || true
        sudo -u postgres psql -v ON_ERROR_STOP=1 -tc "SELECT 1 FROM pg_database WHERE datname = 'betting'" | grep -q 1 \
            || sudo -u postgres createdb betting >/dev/null 2>&1 || true
    fi
}

# 1. Check Infrastructure Dependencies
echo -e "\033[36m=== 1. Checking Infrastructure ===\033[0m"
if ! pg_isready -h localhost -p 5432 >/dev/null 2>&1; then
    echo -e "\033[31m[X] PostgreSQL is not running on port 5432. Starting service...\033[0m"
    sudo service postgresql start
fi
ensure_postgres_database
ensure_risk_engine_binary

# 2. Start Application Microservices
echo -e "\033[36m=== 2. Launching Application Cluster ===\033[0m"

# C++ Risk Engine
run_service "risk_engine" \
    "${ROOT_DIR}/risk_engine" \
    "./build/risk_engine"

# Ingress FastAPI Service (Port 8000)
run_service "ingress_service" \
    "${ROOT_DIR}/ingress_service" \
    "uvicorn app.main:app --host 0.0.0.0 --port 8000"

# Odds Simulator & WebSocket Relay (Port 8001)
run_service "odds_simulator" \
    "${ROOT_DIR}/odds_service" \
    "python simulator.py"

run_service "odds_websocket" \
    "${ROOT_DIR}/odds_service" \
    "uvicorn websocket_server:app --host 0.0.0.0 --port 8001"

# Settlement API (Port 8002) & Worker
run_service "settlement_api" \
    "${ROOT_DIR}/settlement_service" \
    "uvicorn app.main:app --host 0.0.0.0 --port 8002"

run_service "settlement_worker" \
    "${ROOT_DIR}/settlement_service" \
    "python -m app.worker"

echo -e "\n\033[32m=== Cluster Online ===\033[0m"
echo -e "Press \033[1mCTRL+C\033[0m to tail logs or terminate all processes.\n"

# Tail logs into single console stream
tail -f "${LOG_DIR}"/*.log