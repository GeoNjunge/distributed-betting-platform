import { Component, OnInit, computed } from '@angular/core';
import { DecimalPipe, NgClass } from '@angular/common';

import { OddsWebSocketService } from '../../core/services/odds-websocket.service';
import { BetSlipService } from '../../core/services/bet-slip.service';
import { MarketSelectionView } from '../../core/models/odds-tick.model';

interface MarketGroup {
  matchId: string;
  selections: MarketSelectionView[];
}

@Component({
  selector: 'app-market-display',
  standalone: true,
  imports: [DecimalPipe, NgClass],
  template: `
    <section class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-glow backdrop-blur">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-emerald-300">Live Markets</p>
          <h2 class="text-2xl font-semibold text-white">Tick-by-tick odds</h2>
        </div>
        <button class="rounded-xl border border-emerald-400/50 px-4 py-2 text-sm font-semibold text-emerald-200 hover:bg-emerald-400/10" (click)="odds.connect()">
          {{ odds.connected() ? 'Connected' : 'Connect WS' }}
        </button>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        @for (market of groupedMarkets(); track market.matchId) {
          <article class="rounded-2xl border border-white/10 bg-felt-800/80 p-4">
            <div class="mb-3 flex items-center justify-between">
              <h3 class="font-semibold text-white">{{ market.matchId }}</h3>
              <span class="text-xs text-slate-400">{{ market.selections.length }} selections</span>
            </div>
            <div class="grid gap-2">
              @for (selection of market.selections; track selection.key) {
                <button class="grid grid-cols-[1fr_auto] items-center gap-3 rounded-xl border px-4 py-3 text-left transition duration-150 hover:-translate-y-0.5 hover:border-emerald-300"
                        [ngClass]="priceClasses(selection)"
                        (click)="betSlip.select(selection)">
                  <span>
                    <span class="block text-sm font-medium text-white">{{ selection.selectionId }}</span>
                    <span class="block text-xs text-slate-400">seq {{ selection.sequence }}</span>
                  </span>
                  <span class="text-xl font-black text-white">{{ selection.odds | number:'1.2-4' }}</span>
                </button>
              }
            </div>
          </article>
        } @empty {
          <div class="rounded-2xl border border-dashed border-white/15 p-8 text-center text-slate-300 md:col-span-2 xl:col-span-3">
            Waiting for odds ticks from ws://localhost:8001/ws/odds
          </div>
        }
      </div>
    </section>
  `
})
export class MarketDisplayComponent implements OnInit {
  readonly groupedMarkets = computed<MarketGroup[]>(() => {
    const groups = new Map<string, MarketSelectionView[]>();
    for (const selection of this.odds.markets()) {
      groups.set(selection.matchId, [...(groups.get(selection.matchId) ?? []), selection]);
    }
    return Array.from(groups.entries()).map(([matchId, selections]) => ({ matchId, selections }));
  });

  constructor(readonly odds: OddsWebSocketService, readonly betSlip: BetSlipService) {}

  ngOnInit(): void {
    this.odds.connect();
  }

  priceClasses(selection: MarketSelectionView): Record<string, boolean> {
    return {
      'border-emerald-400/70 bg-emerald-500/20': selection.direction === 'up',
      'border-red-400/70 bg-red-500/20': selection.direction === 'down',
      'border-white/10 bg-white/5': selection.direction === 'flat'
    };
  }
}
