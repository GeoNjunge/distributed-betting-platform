{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backboard.local/schemas/odds-update.schema.json",
  "title": "odds-updates tick event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "market_id",
    "selection_id",
    "sequence",
    "timestamp_ms",
    "decimal_odds"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "market_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 1
    },
    "decimal_odds": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+\\.[0-9]{1,4}$" },
        { "type": "number", "exclusiveMinimum": 1.0, "maximum": 1000.0 }
      ]
    }
  }
}
